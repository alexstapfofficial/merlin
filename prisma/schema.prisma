generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id          String   @id @default(cuid())
  name        String
  birthdate   Json
  birthtime   Json
  isOwner     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  coordinates Json
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model places {
  id         BigInt  @id @default(autoincrement())
  plz        String
  name       String
  bundesland String?
  landkreis  String?
  latitude   Float
  longitude  Float

  @@index([name(ops: raw("gin_trgm_ops"))], map: "places_name_trgm", type: Gin)
  @@index([plz])
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model geonames_raw {
  geonameid      BigInt?
  name           String?
  asciiname      String?
  alternatenames String?
  latitude       Float?
  longitude      Float?
  feature_class  String?
  feature_code   String?
  country_code   String?
  cc2            String?
  admin1_code    String?
  admin2_code    String?
  admin3_code    String?
  admin4_code    String?
  population     BigInt?
  elevation      Int?
  dem            Int?
  timezone       String?
  mod_date       DateTime? @db.Date

  @@ignore
}
